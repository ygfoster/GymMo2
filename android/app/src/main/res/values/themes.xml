<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 端末のライト/ダークに追従。起動直後の背景色も Web 側の背景と揃えて、白いチラつきを防ぐ -->
    <style name="Theme.GymMo2" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/app_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
    </style>
</resources>
